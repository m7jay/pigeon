# Pigeon — operator-facing configuration. Copy to .env and edit.
#
# OPS-3: this file is the complete list of settings. If a setting is not here, it
# is not configurable, and that is deliberate. `go test ./internal/config` enforces
# the claim: TestEnvExampleDocumentsEveryKnob fails, naming them, when a variable
# the process reads has no entry here.
# OPS-7: the process refuses to start on an unsafe combination; see `pigeon doctor`.

# ---- HTTP -------------------------------------------------------------------
PIGEON_HTTP_ADDR=:8080
PIGEON_SHUTDOWN_GRACE=20s
PIGEON_SESSION_TTL=12h

# ---- Storage ----------------------------------------------------------------
# The runtime role: it serves requests and must NOT own the tables, because
# PostgreSQL exempts a table owner from row-level security. In the reference
# deployment it is `pigeon_app`, created by deploy/postgres/01-roles.sql.
PIGEON_DATABASE_URL=postgres://pigeon_app:change-me@postgres:5432/pigeon?sslmode=disable
# The owning role, used only by the migration path at boot (CREATE TABLE needs
# it). OPS-7 refuses a configuration that points both URLs at the same role.
PIGEON_MIGRATE_DATABASE_URL=postgres://pigeon_migrator:change-me@postgres:5432/pigeon?sslmode=disable
# OPS-8: replicas × PIGEON_DB_MAX_CONNS + reserved ≤ Postgres max_connections.
# The binary checks this arithmetic against the server at boot and refuses to
# start when it does not fit, naming the numbers. Past one replica, put pgbouncer
# (or equivalent) in front of Postgres - see docs/topology.md.
#
# Since S12 this value is also the default width of the write budget below
# (PIGEON_WRITE_QUEUE_DEPTH=0 follows it), because a budget slot and a pool
# connection are the same resource. The reference default is 40: pool 10 was
# measured to serialise a single publish for 10.2 s against 40 concurrent
# publishers on the 2 vCPU reference box, and pool 40 measured 86 ms. The
# arithmetic against a default Postgres (max_connections=100, reserved 5):
#   1 replica   1 x 40 + 5 =  45  ≤ 100   fits
#   2 replicas  2 x 40 + 5 =  85  ≤ 100   fits
#   4 replicas  4 x 40 + 5 = 165  > 100   REFUSED at boot - use pgbouncer or a
#                                         lower PIGEON_DB_MAX_CONNS there.
PIGEON_DB_MAX_CONNS=40
PIGEON_DB_RESERVED_CONNS=5
PIGEON_CORE_REPLICAS=1
PIGEON_REDIS_URL=redis://redis:6379/0
# OPS-9: exactly one migrator. Keep true on the single-replica default; set false
# on replicas 2..N so only one process contends for the advisory lock.
PIGEON_MIGRATIONS_ON_BOOT=true

# ---- Deployment identity (FR-1007) ------------------------------------------
# The allowlist GET /v1/meta/egress-ips publishes: the addresses your deliveries
# come from, so a consumer can allowlist them before an endpoint starts refusing
# traffic. Comma-separated addresses or CIDR blocks. Leave it empty on a flat
# network, where the instance reads its own interfaces; behind NAT, a load
# balancer, a proxy or a container network you MUST set it - the address a
# receiver sees is not the one the process can discover, and the discovered
# answer says so instead of pretending. A malformed entry is refused at boot
# (OPS-7), because this list is a delivery outage on someone else's side if it is
# wrong.
PIGEON_EGRESS_IPS=

# ---- Identity ---------------------------------------------------------------
# FR-101: the bootstrap instance-admin credential. Required on first run, and
# ignored afterwards (an existing admin is never overwritten). The first login
# must change it.
PIGEON_INSTANCE_ADMIN_PASSWORD=change-me-to-something-long
# FR-102: off by default. On, POST /v1/producers creates a tenant and its first
# owner without an instance admin. Never enable it on an internet-facing instance
# unless that is what you mean.
PIGEON_SELF_REGISTRATION=false

# FR-111's password-reset flow (S9a). The window is short, because a reset link
# in a mailbox is a credential; and it MUST be positive, or no reset could ever be
# redeemed. The transport is the deployment's: v1.0 ships no mailer, so the token
# goes to the core's notifier seam (see cmd/pigeon's resetNotifier), and the
# operator decides where it goes from there.
PIGEON_PASSWORD_RESET_TTL=1h
# Off by default, and it should stay off anywhere the logs leave the host: on, the
# core writes the reset token itself to the log, which is a reset link in a shared
# log - a credential in a shared log. It is for a single-operator instance that has
# no other channel to hand the link over.
PIGEON_PASSWORD_RESET_LOG_TOKENS=false
# FR-106: the optional OIDC login. The core needs only the issuer and the client
# id, because it VERIFIES an id_token the portal already obtained; the client
# secret and the redirect URI belong to the portal (the relying party) and are read
# there, so this process never holds the value that lets a caller speak for the
# portal at the issuer. Both empty - the default - means the feature is off: no
# OIDC control on the portal and a 404 for POST /v1/session/oidc. Set both together
# to turn it on; the portal's half is in the Producer portal block below.
PIGEON_OIDC_ISSUER=
PIGEON_OIDC_CLIENT_ID=

# ---- Rate limits (FR-207) ---------------------------------------------------
# In-process, per replica: N replicas allow N times this rate. 0 disables the
# corresponding limit. See SPEC.md ("S1 decisions") for why this is not Redis yet.
PIGEON_RATE_LIMIT_PER_KEY_RPS=50
PIGEON_RATE_LIMIT_PER_KEY_BURST=100
PIGEON_RATE_LIMIT_PER_PRODUCER_RPS=200
PIGEON_RATE_LIMIT_PER_PRODUCER_BURST=400

# ---- Delivery worker (FR-802…FR-817) ----------------------------------------
# PIGEON_DELIVERY_WORKERS claim loops per replica. Each loop serves both attempt
# lanes (FR-1303), and the lanes partition PIGEON_DELIVERY_CONCURRENCY rather than
# adding to it: in-flight attempts for one process stay at or below it (FR-816),
# and the total across replicas is replicas × PIGEON_DELIVERY_CONCURRENCY. A loop
# leases a due delivery, signs the envelope with the endpoint's own secret
# (FR-1001), POSTs it under a per-attempt timeout, and writes only on completion,
# terminal failure, or a retryable failure's requeue (FR-811, FR-813). 0 runs the
# process with no delivery worker at all - an API-only replica, or an instance
# whose deliveries another replica serves; a negative value is refused at boot.
# Where a setting below has a ceiling, the process clamps to it rather than
# refusing, so one careless env var degrades instead of voiding a requirement; a
# value the process cannot make safe is refused at boot, naming the variable.
PIGEON_DELIVERY_WORKERS=1
# How long a claim holds the row before another worker may take it. Keep it
# comfortably above PIGEON_DELIVERY_TIMEOUT: a lease that lapses mid-attempt lets a
# second worker claim the same delivery while the first is still in flight. The
# attempt number stays unique either way (FR-902, AC-07), but the receiver sees
# the POST twice, which is why consumers dedupe on the webhook id.
PIGEON_DELIVERY_LEASE=40s
# FR-802: the per-attempt timeout. 5 s is a ceiling, not a default - a receiver
# that cannot acknowledge inside it is treated as unavailable - so a larger value
# is clamped to 5 s at boot. An endpoint-level override within [2 s, 5 s] is a
# per-endpoint setting, not this one.
PIGEON_DELIVERY_TIMEOUT=5s
# FR-804/SB-4: how much of a failed attempt's response body is kept, in bytes.
# 0 stores no body at all (SB-4's "configurable down to 0") and a negative value is
# refused at boot. The body dominates per-row cost (docs/retention.md), so this is
# the first setting to lower when `attempts` grows faster than the disk allows.
PIGEON_DELIVERY_MAX_BODY_BYTES=2048
# The retry schedule: the delay before attempt N+1 is base × 2^(N-1), capped at
# PIGEON_DELIVERY_BACKOFF_MAX. FR-807: a Retry-After on a 429/503 (itself capped
# at 300 s) wins over the computed value.
PIGEON_DELIVERY_BACKOFF_BASE=30s
PIGEON_DELIVERY_BACKOFF_MAX=12h
# §9's retry budget, counted in retries: the default of 15 allows at most 16
# attempts including the first, and the attempt that exhausts the budget ends the
# delivery failed rather than retrying forever. 0 or a negative value is refused
# at boot.
PIGEON_DELIVERY_MAX_RETRIES=15
# §9's per-delivery retry window. The window takes precedence over the retry count
# (FR-1201): once it has elapsed the delivery fails even with budget left, because
# an endpoint that has been down for three days is not coming back on the next
# backoff. It MUST be between 1h and 168h (7 d); anything else is refused at boot.
PIGEON_DELIVERY_RETRY_WINDOW=72h
# §9: the fractional spread on every computed delay - 0.2 is ±20%. It is mandatory
# in production, because a burst of failures retrying in lockstep is a second spike
# against an endpoint that is already down. Must be between 0 and 1.
PIGEON_DELIVERY_JITTER=0.2
# FR-816: the per-process cap on concurrent attempts - this replica's backpressure
# bound, not any one endpoint's promise (that is PIGEON_DELIVERY_MAX_CONNS_PER_HOST,
# or the endpoint's own override). It MUST be >= 1.
PIGEON_DELIVERY_CONCURRENCY=64
# FR-1303: the retry lane's share of PIGEON_DELIVERY_CONCURRENCY. The worker
# partitions this process's attempt budget into a retry lane and a first-attempt
# lane, and clamps this value into [0, PIGEON_DELIVERY_CONCURRENCY - 1] so the
# first-attempt lane always keeps at least one slot - 16 retrying and 48 taking
# first attempts at the defaults above. It MUST be >= 1: 0 would stop retrying,
# which FR-1201 forbids, so a configured 0 is refused at boot rather than read as
# "no retries".
PIGEON_DELIVERY_RETRY_CONCURRENCY=16
# FR-1302: how long a Redis concurrency slot is held before it expires. It has to
# outlast an attempt, or an expired slot would let an endpoint's cap be exceeded;
# 0 - and any value not longer than PIGEON_DELIVERY_TIMEOUT - is raised to three
# times the timeout (15 s at the defaults above). It is what lets a crashed
# worker's slots expire instead of holding an endpoint's capacity forever; a
# negative value is refused at boot.
PIGEON_DELIVERY_SLOT_TTL=0
# FR-817/FR-1302: the deployment's default per-endpoint concurrency cap, used when
# the endpoint sets no override of its own. Every endpoint gets its own transport,
# so this is per endpoint, not a global pool; keep-alives stay on and every
# response body is drained and closed on all paths, so a slow endpoint cannot leak
# connections. Must be >= 1.
PIGEON_DELIVERY_MAX_CONNS_PER_HOST=10
# How often an idle worker re-scans for a due delivery. Nothing depends on this for
# correctness - the sweeper re-queues lapsed leases on its own cadence (D-6) - so
# raise it to trade claim latency for query load.
PIGEON_DELIVERY_POLL_INTERVAL=1s
# FR-810: the User-Agent header on every attempt. Empty means
# "pigeon/<build version>", which is what the requirement asks for (platform and
# version); set it only to identify a fork or a downstream deployment.
PIGEON_DELIVERY_USER_AGENT=

# ---- Sweeper (D-6, D-7) -----------------------------------------------------
# One sweeper per deployment holds the leadership lock (D-7); every other replica
# keeps competing for it and takes over when the holder dies. The sweeper
# re-queues every delivery whose lease has lapsed, which is the guaranteed recovery
# path - the worker claim loop is opportunistic.
# D-6: the cadence is a ceiling, not a default - a delivery held by a crashed
# worker MUST be re-queued within 10 s - so a larger value is clamped to 10 s at
# boot, and 0 falls back to 5 s. Raising it costs recovery latency for a delivery
# whose worker died.
PIGEON_SWEEPER_INTERVAL=5s
# The DSN for the dedicated connection that holds the leadership lock. Empty means
# PIGEON_DATABASE_URL. It must stay reachable for the process's lifetime: the
# session-level advisory lock is released when that one connection closes, which is
# also why a partition or a SIGKILL frees it without a timeout (D-7). An
# unreachable DSN is not fatal, and not silent either: the sweeper logs "sweeper
# stopped unexpectedly: ... lock DSN unreachable" at error level and the process
# keeps serving without a sweeper, so D-6's lease recovery and SB-3's partition
# drops stop until it is restarted with a reachable DSN. Alert on that line -
# nothing else the process prints says the sweeper is gone.
PIGEON_SWEEPER_LOCK_URL=
# How long a replica competes for the leadership lock before it announces, at info
# level, that it is standing by. It does not stop competing: giving up is how a
# deployment ends up with no sweeper at all after the first holder dies (AC-42), so
# this value only decides when the standby says so in the log.
PIGEON_SWEEPER_LOCK_WAIT=60s

# ---- Write budget (S12, FR-818 amended by SPEC.md A-11) ----------------------
# ONE bounded write budget per process, shared by ingest and by every
# control-state writer (the relay's fan-out inserts, the delivery worker's
# completions, terminal transitions and requeues). It exists because the publish
# path used to take a pool connection with no deadline, so past the machine's
# write ceiling the instance PARKED on the pool instead of shedding: S10's load
# test offered 250 events/s for 30 minutes and measured zero 429s with a p99 that
# grew from 3,593.4 ms to 4,281.6 ms. With the budget, ingest is admitted within
# PIGEON_INGEST_ADMIT_TIMEOUT or refused with 429 `over_capacity` (a code
# deliberately distinct from the disk gate's `over_budget`), and the workers'
# writes batch into fewer, larger transactions (FR-815).
#
# How many database writes may be in flight at once. 0 means "follow
# PIGEON_DB_MAX_CONNS", which is the shipped default because a budget slot and a
# pool connection are the same resource: an explicit value is clamped into
# [2, PIGEON_DB_MAX_CONNS]. Below 2 it would serialise every write in the process
# behind whoever holds the slot; above the pool it is only a longer queue in
# front of the same connections, which is the parking this budget removed.
PIGEON_WRITE_QUEUE_DEPTH=0
# The fixed batch-writer pool. Fixed at boot, never a goroutine per event or per
# delivery (FR-816). Must be >= 1: with no writer the budget has nobody to commit
# a batched write, so the process refuses to boot rather than accept work it will
# never write.
PIGEON_WRITE_QUEUE_WORKERS=2
# How long a publish waits for a slot of the budget before it is shed with 429.
# The default is NFR-1's rated publish p99 (100 ms), because admission must never
# be the reason a publish exceeds it. Must be > 0 and <= 1 s: zero would mean "no
# deadline", and anything above a second parks a request far past the latency the
# platform promises, which is the behaviour A-11 removed.
PIGEON_INGEST_ADMIT_TIMEOUT=100ms

# ---- Attempt evidence buffering (D-1, D-2, FR-812, FR-815) ------------------
# D-2: how a failed attempt's evidence row reaches Postgres.
#   buffered  the worker pushes it to the Redis buffer (D-1) and the flusher
#             drains it in batches. The default, and the path D-1 mandates: a
#             worker holds no evidence in its own memory.
#   sync      the worker writes it inline, one batched insert per attempt, for
#             operators who value evidence over throughput.
# `buffered` requires PIGEON_REDIS_URL, because the alternative to the buffer is
# process memory, which is the failure mode D-1 exists to prevent; the process
# refuses to boot rather than degrade to it. Any other value is refused too.
PIGEON_ATTEMPT_LOG_MODE=buffered
# FR-815: rows per flush transaction, and a floor rather than a target - a value
# below it is raised to 2,000 at boot, negative included, so one env var cannot
# turn the evidence path back into single-row commits and thousands of commit
# fsyncs per second. The insert is the evidence class (synchronous_commit=off,
# FR-812); retry and status never depend on it (D-2).
PIGEON_ATTEMPT_FLUSH_BATCH=2000
# How long an idle flusher waits between passes, and therefore the worst-case lag
# between an attempt happening and its row being visible. §6 bounds that evidence
# tail at 1 s, so a larger value is clamped to 1 s at boot; a negative value is
# refused, and 0 falls back to 1 s.
PIGEON_ATTEMPT_FLUSH_INTERVAL=1s
# How long another replica's pending batch must be untouched before this flusher
# takes it over - the peer died mid-flush. Keep it well above the flush interval; a
# restart reclaims its own predecessor's batch immediately, so this only governs a
# peer that is still running or died without this replica restarting. 0 is accepted
# and takes a peer's pending batch over at once - two replicas then insert the same
# rows, which the primary key makes a no-op but which is wasted work; a negative
# value is refused at boot.
PIGEON_ATTEMPT_FLUSH_STALE=30s
# LOG-2: the bound on successful-delivery log lines per second. Successes above it
# increment counters instead, and failures and state transitions always log at warn.
# The floor is one line per second, not zero - an operator still needs a liveness
# signal - so 0 and a negative value are both raised to 1, while unset is the 100
# shown here. The counters carry the volume either way.
PIGEON_SUCCESS_LOG_RPS=100

# ---- Retention (SB-3, SB-5, FR-905) -----------------------------------------
# How long history is kept. Deliveries and attempts leave by whole day partition
# (never by DELETE); under disk pressure (PIGEON_RETENTION_MAX_DISK_PCT, below) a
# partition goes before its window and the sweeper logs what that cost at warn.
# A Go duration, so 14 days is 336h - there is no `d` unit. Every window MUST be
# positive (SB-5): 0 is not "keep everything", it is "drop everything", so a
# non-positive value is refused at boot rather than silently deleting history.
# §8.1.1: the sustained rate this instance can run is usable disk / (bytes per
# delivery × retention seconds), so a fixed window on a fixed disk shortens the
# effective window as throughput rises - the disk binds long before the CPU write
# path does. docs/retention.md carries the per-row numbers to size them with.
PIGEON_RETENTION_DELIVERIES=336h
PIGEON_RETENTION_ATTEMPTS=168h
PIGEON_RETENTION_EVENTS=336h
# FR-905: the dedupe archive. It is what answers "was this a duplicate for this
# endpoint?" after the deliveries partition holding the key has been dropped, so
# it carries the difference between the two windows (FR-903 asks for 30 days).
# Shortening it shortens that answer; under disk pressure its partitions are
# dropped oldest-first, before any deliveries partition, because they are derived.
PIGEON_RETENTION_DEDUPE=720h
# SB-3: the disk budget, as a percentage of the volume that holds the data. At or
# above it the sweeper drops the oldest droppable partition before age is
# considered, and ingest sheds when nothing is old enough to drop (SB-7). Must be
# between 1 and 100: a 0% budget would drop history on an empty disk and a >100% one
# would never drop at all, so both are refused at boot rather than clamped - a
# silent clamp would hide the misconfiguration until the disk filled.
PIGEON_RETENTION_MAX_DISK_PCT=80
# Where that percentage is measured: the filesystem holding the Postgres data
# directory. Set it when core and Postgres share a volume, which is the normal
# single-host deployment; the reading is statfs and reports itself as `statfs:<dir>`
# in GET /v1/meta/usage. Empty disables the filesystem reading and leaves the
# fallback below.
PIGEON_DISK_DIR=
# The fallback for a deployment where core cannot see that filesystem: pigeon's own
# pg_database_size is compared against this number instead (source `database`).
# Binary suffixes are accepted - 40GiB, 512MiB - as is a plain byte count. With
# neither this nor PIGEON_DISK_DIR the reading source is `none`, GET /v1/meta/usage
# answers 503 and ingest never sheds: a documented degraded mode rather than a
# fabricated 0%.
PIGEON_DISK_BYTES=

# ---- Observability ----------------------------------------------------------
PIGEON_LOG_LEVEL=info
PIGEON_LOG_JSON=true

# ---- At-rest encryption (FR-1006) ------------------------------------------
# Endpoint custom header values (FR-405) are stored encrypted: AES-256-GCM under
# this key, a fresh nonce per value, and the endpoint id as additional
# authenticated data, so a ciphertext cannot be moved to another endpoint's row.
# It is REQUIRED and the process refuses to start without it (or with a key that
# is not exactly 32 bytes of base64), because the alternative is a platform that
# accepts a header value and has nowhere safe to put it.
#
# Generate one and keep it stable:   openssl rand -base64 32
#
# There is no rotation support yet. Rotating this key would require re-sealing
# every stored value (a migration), and a deployment that loses it cannot read
# the header values already stored - they can be deleted and re-registered, but
# they cannot be recovered. See docs/at-rest-encryption.md.
PIGEON_HEADERS_KEY=change-me-32-bytes-of-base64-openssl-rand

# ---- Deployment secrets (compose.yaml) --------------------------------------
# These two are consumed by compose, not by the core binary. compose.yaml has no
# defaults for them on purpose: `docker compose up` refuses to start until both
# are set, so a deployment cannot accidentally ship a published password. Use
# different values from each other, and from PIGEON_INSTANCE_ADMIN_PASSWORD.
#   POSTGRES_PASSWORD     the pigeon_migrator (schema owner) password
#   PIGEON_APP_PASSWORD   the pigeon_app (runtime, RLS-constrained) password
POSTGRES_PASSWORD=change-me-migrator-password
PIGEON_APP_PASSWORD=change-me-runtime-password

# ---- Consumer portal (M2b, UI-12…UI-19) -------------------------------------
# A separate, independently themeable deployable that is a thin client of the
# core API. It may be omitted entirely: the core keeps serving the consumer
# self-service API with the same server-side scoping, and consumer users simply
# have no UI (UI-19, AC-40). Copy this block in only if you run the portal.
#   PIGEON_PORTAL_ADDR          listen address (default :8082)
#   PIGEON_CORE_API_URL         base URL of the core API (in compose: http://core:8080)
#   PORTAL_SESSION_SECRET       encrypts the consumer session cookie and keys the CSRF token; required, keep it stable
#   PORTAL_SESSION_COOKIE_NAME  session cookie name (default consumer_session)
#   PORTAL_BRAND_*              producer branding carried by the portal (UI-17); all optional
# There is deliberately no PORTAL_SESSION_TTL. The portal's session cookie lives
# exactly as long as the core session it carries: PIGEON_SESSION_TTL above sets
# the duration, and the portal reads it from the login response's expires_at.
# A second knob would drift from the first and let a cookie outlive its token.
PIGEON_PORTAL_ADDR=:8082
PIGEON_CORE_API_URL=http://core:8080
PORTAL_SESSION_SECRET=change-me-consumer-portal-secret
PORTAL_SESSION_COOKIE_NAME=consumer_session
PORTAL_BRAND_NAME=
PORTAL_BRAND_ACCENT=
PORTAL_BRAND_LOGO_URL=
PORTAL_BRAND_COMPANY=

# ---- Producer portal (M2a, UI-1…UI-11) --------------------------------------
# A separate, independently themeable deployable that is a thin client of the
# core API with no database and no workers. It may be omitted entirely: the core
# keeps serving the producer API with the same server-side scoping, and producer
# members simply have no UI (AC-40). Copy this block in only if you run it.
#   PIGEON_PRODUCER_PORTAL_ADDR            listen address (default :8083)
#   PIGEON_PRODUCER_PORTAL_SESSION_SECRET  encrypts the producer session cookie and keys the CSRF token; required, keep it stable
#   PIGEON_PRODUCER_PORTAL_COOKIE_NAME     session cookie name (default producer_session)
#   PIGEON_PRODUCER_PORTAL_ENV             the plane the portal starts in, test or live (default test)
#   PIGEON_OIDC_*                          FR-106's optional OIDC login, the relying-party half (below)
# It reads PIGEON_CORE_API_URL (set under Consumer portal above) and the same
# PORTAL_BRAND_* knobs. As with the consumer portal there is deliberately no
# portal-side session TTL: the cookie lives exactly as long as the core session
# it carries.
#
# PIGEON_PRODUCER_PORTAL_SESSION_SECRET is consumed by compose, which has no
# default for it on purpose: `docker compose up` refuses to start until it is
# set, so a deployment cannot accidentally ship the change-me placeholder below.
# Generate one and keep it stable - changing it logs every portal user out.
PIGEON_PRODUCER_PORTAL_ADDR=:8083
PIGEON_PRODUCER_PORTAL_SESSION_SECRET=change-me-producer-portal-secret
PIGEON_PRODUCER_PORTAL_COOKIE_NAME=producer_session
PIGEON_PRODUCER_PORTAL_ENV=test

# FR-106's OIDC login, the relying-party half. Optional, and off unless
# PIGEON_OIDC_ISSUER and PIGEON_OIDC_CLIENT_ID are both set (Identity section
# above); with no issuer the portal renders no OIDC control at all. The client
# secret is the value that lets a process speak for this portal at the issuer, so
# it lives only in the portal - it is never handed to the core, which verifies the
# id_token and nothing more. Replace the placeholder; it is not a secret.
#   PIGEON_OIDC_REDIRECT_URL  the portal's callback URL, registered at the issuer
#   PIGEON_OIDC_SCOPES        comma-separated; default openid,email,profile
PIGEON_OIDC_CLIENT_SECRET=change-me-oidc-client-secret
PIGEON_OIDC_REDIRECT_URL=https://producer.example/login/oidc/callback
PIGEON_OIDC_SCOPES=openid,email,profile

# ---- Load-test harness (cmd/loadgen, §16) -----------------------------------
# The generator the load protocol is measured with - not a deployment component:
# §12 puts the generator off the machine under test, so it runs on its own host or
# in its own container, and the core never reads either setting below.
# docs/load-test.md is the runbook, and the graded runs (AC-16, AC-17, AC-43 and
# AC-30's third clause) are the operator's, on a host that carries the class. These
# two are here because the harness reads them from the environment, and this file is
# the complete list of settings.
#
# The DSN the harness reconciles against. `seed -db` and `run -db` fall back to it,
# and `run` reads it again for the Postgres version it records in the report's
# machine block. It is the instance's own database - the reconciliation counts the
# rows that instance committed, so a copy is not a substitute, and a run that
# declares a class is refused without it (§12 counts accepted events in events and
# outbox, not in the generator's own counter). Empty, the default, means no
# fallback: `seed` refuses without a DSN, and `run` without one reports the
# generator's own tally rather than the instance's rows.
PIGEON_LOADGEN_DB=
# The producer API key `run` publishes with. `seed` prints one, as
# PIGEON_LOADGEN_KEY=<key>, once it has created the producer, so the printed line
# can be exported for the run; -key takes the same value on the command line. It is
# a credential, and the report carries neither it nor the DSN: both are read from
# the environment, so this file or your shell is the only place they live.
PIGEON_LOADGEN_KEY=
