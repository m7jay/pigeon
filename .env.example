# Pigeon — operator-facing configuration. Copy to .env and edit.
#
# OPS-3: this file is the complete list of knobs. If a setting is not here, it is
# not configurable, and that is deliberate.
# OPS-7: the process refuses to start on an unsafe combination; see `pigeon doctor`.

# ---- HTTP -------------------------------------------------------------------
PIGEON_HTTP_ADDR=:8080
PIGEON_SHUTDOWN_GRACE=20s
PIGEON_SESSION_TTL=12h

# ---- Storage ----------------------------------------------------------------
# The runtime role: it serves requests and must NOT own the tables, because
# PostgreSQL exempts a table owner from row-level security. In the reference
# deployment it is `pigeon_app`, created by deploy/postgres/01-roles.sql.
PIGEON_DATABASE_URL=postgres://pigeon_app:change-me@postgres:5432/pigeon?sslmode=disable
# The owning role, used only by the migration path at boot (CREATE TABLE needs
# it). OPS-7 refuses a configuration that points both URLs at the same role.
PIGEON_MIGRATE_DATABASE_URL=postgres://pigeon_migrator:change-me@postgres:5432/pigeon?sslmode=disable
# OPS-8: replicas × PIGEON_DB_MAX_CONNS + reserved ≤ Postgres max_connections.
# The binary checks this arithmetic against the server at boot and refuses to
# start when it does not fit, naming the numbers. Past one replica, put pgbouncer
# (or equivalent) in front of Postgres - see docs/topology.md.
PIGEON_DB_MAX_CONNS=10
PIGEON_DB_RESERVED_CONNS=5
PIGEON_CORE_REPLICAS=1
PIGEON_REDIS_URL=redis://redis:6379/0
# OPS-9: exactly one migrator. Keep true on the single-replica default; set false
# on replicas 2..N so only one process contends for the advisory lock.
PIGEON_MIGRATIONS_ON_BOOT=true

# ---- Identity ---------------------------------------------------------------
# FR-101: the bootstrap instance-admin credential. Required on first run, and
# ignored afterwards (an existing admin is never overwritten). The first login
# must change it.
PIGEON_INSTANCE_ADMIN_PASSWORD=change-me-to-something-long
# FR-102: off by default. On, POST /v1/producers creates a tenant and its first
# owner without an instance admin. Never enable it on an internet-facing instance
# unless that is what you mean.
PIGEON_SELF_REGISTRATION=false

# ---- Rate limits (FR-207) ---------------------------------------------------
# In-process, per replica: N replicas allow N times this rate. 0 disables the
# corresponding limit. See SPEC.md ("S1 decisions") for why this is not Redis yet.
PIGEON_RATE_LIMIT_PER_KEY_RPS=50
PIGEON_RATE_LIMIT_PER_KEY_BURST=100
PIGEON_RATE_LIMIT_PER_PRODUCER_RPS=200
PIGEON_RATE_LIMIT_PER_PRODUCER_BURST=400

# ---- Observability ----------------------------------------------------------
PIGEON_LOG_LEVEL=info
PIGEON_LOG_JSON=true

# ---- Deployment secrets (compose.yaml) --------------------------------------
# These two are consumed by compose, not by the core binary. compose.yaml has no
# defaults for them on purpose: `docker compose up` refuses to start until both
# are set, so a deployment cannot accidentally ship a published password. Use
# different values from each other, and from PIGEON_INSTANCE_ADMIN_PASSWORD.
#   POSTGRES_PASSWORD     the pigeon_migrator (schema owner) password
#   PIGEON_APP_PASSWORD   the pigeon_app (runtime, RLS-constrained) password
POSTGRES_PASSWORD=change-me-migrator-password
PIGEON_APP_PASSWORD=change-me-runtime-password
