# Pigeon — operator-facing configuration. Copy to .env and edit.
#
# OPS-3: this file is the complete list of knobs. If a setting is not here, it is
# not configurable, and that is deliberate.
# OPS-7: the process refuses to start on an unsafe combination; see `pigeon doctor`.

# ---- HTTP -------------------------------------------------------------------
PIGEON_HTTP_ADDR=:8080
PIGEON_SHUTDOWN_GRACE=20s
PIGEON_SESSION_TTL=12h

# ---- Storage ----------------------------------------------------------------
PIGEON_DATABASE_URL=postgres://pigeon:pigeon@postgres:5432/pigeon?sslmode=disable
# OPS-8: replicas × PIGEON_DB_MAX_CONNS + reserved ≤ Postgres max_connections.
PIGEON_DB_MAX_CONNS=10
PIGEON_REDIS_URL=redis://redis:6379/0
# OPS-9: exactly one migrator. Keep true on the single-replica default; set false
# on replicas 2..N so only one process contends for the advisory lock.
PIGEON_MIGRATIONS_ON_BOOT=true

# ---- Identity ---------------------------------------------------------------
# FR-101: the bootstrap instance-admin credential. Required on first run, and
# ignored afterwards (an existing admin is never overwritten).
PIGEON_INSTANCE_ADMIN_PASSWORD=change-me-to-something-long

# ---- Observability ----------------------------------------------------------
PIGEON_LOG_LEVEL=info
PIGEON_LOG_JSON=true
